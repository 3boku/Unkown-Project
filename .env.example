# ==============================================================================
# 1. Google Gemini API 설정
# ==============================================================================
# Google AI Studio에서 발급받은 Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY="your-gemini-api-key-here"

# 기본 사용할 제미나이 모델 (기본값: gemini-2.5-flash)
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"

# ==============================================================================
# 2. Google Cloud / GCS (Google Cloud Storage) 설정
# ==============================================================================
# GCP 프로젝트 ID 및 기본 GCS 버킷 이름
GCP_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET_NAME="your-gcs-bucket-name"

# [인증 방법 A] 로컬 gcloud CLI (ADC) 또는 서비스 계정 JSON 키 파일 경로
# - 로컬에서 `gcloud auth application-default login` 실행 시 비워두어도 자동 인증됩니다.
# - JSON 키 파일을 직접 지정하려면 절대/상대 경로를 입력하세요 (예: ./service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=""

# [인증 방법 B] 서버리스(Vercel 등) 환경을 위한 서비스 계정 인라인 환경변수 (선택)
# - 위 JSON 파일 대신 환경변수로 직접 주입할 때 사용합니다.
GCP_CLIENT_EMAIL=""
GCP_PRIVATE_KEY=""
